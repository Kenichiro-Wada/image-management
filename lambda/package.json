{
  "name": "image-management-lambda",
  "version": "1.0.0",
  "description": "Lambda functions for Image Management System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp package.json package-lock.json dist/ && cd dist && npm install --omit=dev && npm install --os=linux --cpu=x64 sharp",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "aws",
    "lambda",
    "image-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.985.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.700.0",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "exif-parser": "^0.1.12",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^7.0.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "fast-check": "^4.5.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
