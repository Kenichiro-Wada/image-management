# API Gateway エンドポイント
VITE_API_ENDPOINT=https://your-api-gateway-url.execute-api.ap-northeast-1.amazonaws.com/dev

# Cognito設定
VITE_COGNITO_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_USER_POOL_CLIENT_ID=your-user-pool-client-id

# CloudFront配信URL
VITE_CLOUDFRONT_IMAGES_URL=https://your-cloudfront-images-url.cloudfront.net
VITE_CLOUDFRONT_THUMBNAILS_URL=https://your-cloudfront-thumbnails-url.cloudfront.net

# Google reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
